# LLM: "anthropic" uses Claude; "mock" runs a deterministic offline heuristic (no API key needed)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Server-side refusal fallback (Claude API only; disable on Bedrock/Vertex/Foundry)
ANTHROPIC_REFUSAL_FALLBACK=true

# Vector store: "milvus" or "memory"
VECTOR_BACKEND=milvus
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=resume_knowledge
EMBEDDING_DIM=384

# Checkpointer for human-in-the-loop state: memory | sqlite | postgres
CHECKPOINT_BACKEND=sqlite
SQLITE_PATH=./data/checkpoints.sqlite
DATABASE_URL=

# Workflow tuning
QUALITY_THRESHOLD=8.0
MAX_AUTO_REVISIONS=2

# Optional shared-secret auth for the API (sent as X-API-Key)
API_AUTH_TOKEN=
