# LLM provider: "auto" (every provider below that has a key, in this failover order:
# gemini -> openrouter -> openai_compat -> anthropic), one name, a comma list, or "mock" (offline).
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# Tried in order when the main model hits its quota (each model has its own free-tier quota)
GEMINI_FALLBACK_MODELS=gemini-flash-latest
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# OpenRouter: free hosted models (IDs ending in :free; 50 requests/day without purchased credits)
OPENROUTER_API_KEY=
OPENROUTER_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3.5-super-vl:free,dots-studio/dots-3-note-preview:free,google/gemma-4-26b-a4b-it:free,openrouter/free
# Any other OpenAI-compatible API (Groq, Together, a vLLM server, ...)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODELS=
# Server-side refusal fallback (Claude API only; disable on Bedrock/Vertex/Foundry)
ANTHROPIC_REFUSAL_FALLBACK=true

# Vector store: "milvus" or "memory"
VECTOR_BACKEND=milvus
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=resume_knowledge
# Embeddings: "auto" = Gemini's hosted embedding API when GEMINI_API_KEY is set, else local hashing
EMBEDDING_BACKEND=auto
EMBEDDING_DIM=384
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=768

# Checkpointer for human-in-the-loop state: memory | sqlite | postgres
CHECKPOINT_BACKEND=sqlite
SQLITE_PATH=./data/checkpoints.sqlite
DATABASE_URL=

# Workflow tuning
QUALITY_THRESHOLD=8.0
MAX_AUTO_REVISIONS=2

# Optional shared-secret auth for the API (sent as X-API-Key)
API_AUTH_TOKEN=
